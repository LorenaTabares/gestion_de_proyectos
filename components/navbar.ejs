<nav class="navbar">

    <div class="navbar-brand">
        <span class="brand-title">
            AdventureWorks
        </span>
    </div>

    <ul class="navbar-links">
        <li>
            <a
                href="/catalogo"
                class="<%= typeof pagina !== 'undefined' && pagina === 'catalogo' ? 'active' : '' %>"
            >
                Catálogo
            </a>
        </li>

        <!-- Solo visible si el usuario existe y su rol es trabajador -->
        <% if (typeof usuario !== 'undefined' && usuario && usuario.Rol === 'trabajador') { %>
            <li>
                <a
                    href="/inventario"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'inventario' ? 'active' : '' %>"
                >
                    Inventario
                </a>
            </li>

            <li>
                <a href="/reportes">
                    Reportes
                </a>
            </li>
        <% } %>
    </ul>

    <div class="navbar-actions">

        <a href="/carrito" class="btn-carrito">
            <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path
                    d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
                ></path>
            </svg>
            <span>Carrito</span>
        </a>

        <!-- Badge dinámico para mostrar el Rol real -->
        <span class="user-badge" style="text-transform: capitalize;">
            <%= (typeof usuario !== 'undefined' && usuario && (usuario.Rol || usuario.rol)) ? (usuario.Rol || usuario.rol) : 'Cliente' %>
        </span>

        <a href="/logout" class="btn-logout">
            Cerrar Sesión
        </a>

    </div>

</nav>