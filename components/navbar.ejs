
<nav class="navbar">

    <!-- LOGO / NOMBRE -->
    <div class="navbar-brand">
        <span class="brand-title">
            AdventureWorks
        </span>
    </div>

    <!-- OBTENER EL ROL DEL USUARIO -->
    <%
        let rolActual = 'cliente';

        if (typeof usuario !== 'undefined' && usuario) {
            if (usuario.Rol) {
                rolActual = String(usuario.Rol).toLowerCase();
            } else if (usuario.role) {
                rolActual = String(usuario.role).toLowerCase();
            }
        }
    %>

    <!-- ENLACES DE NAVEGACIÓN -->
    <ul class="navbar-links">

        <!-- VISTAS PARA CLIENTES -->
        <% if (rolActual === 'cliente') { %>

            <li>
                <a
                    href="/catalogo"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'catalogo' ? 'active' : '' %>"
                >
                    Catálogo
                </a>
            </li>

            <li>
                <a
                    href="/mis-pedidos"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'pedidos' ? 'active' : '' %>"
                >
                    Mis Pedidos
                </a>
            </li>

        <% } %>

        <!-- VISTAS PARA TRABAJADORES -->
        <% if (rolActual === 'trabajador') { %>

            <li>
                <a
                    href="/inventario"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'inventario' ? 'active' : '' %>"
                >
                    Inventario
                </a>
            </li>

            <li>
                <a
                    href="/reportes"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'reportes' ? 'active' : '' %>"
                >
                    Reportes
                </a>
            </li>

        <% } %>

        <!-- VISTAS PARA ADMINISTRADORES -->
        <% if (rolActual === 'administrador') { %>

            <li>
                <a
                    href="/admin/usuarios"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'admin-usuarios' ? 'active' : '' %>"
                >
                    Administración de usuarios
                </a>
            </li>

        <% } %>

    </ul>

    <!-- ACCIONES DE LA BARRA -->
    <div class="navbar-actions">

        <!-- CARRITO SOLO PARA CLIENTES -->
        <% if (rolActual === 'cliente') { %>

            <a href="/carrito" class="btn-carrito">

                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>

                    <path
                        d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
                    ></path>
                </svg>

                <span>Carrito</span>

            </a>

        <% } %>

        <!-- PERFIL DEL USUARIO -->
        <% if (typeof usuario !== 'undefined' && usuario) { %>

            <a
                href="/perfil"
                class="user-profile-link"
                title="Abrir mi cuenta"
            >

                <span class="user-name">
                    <%= usuario.FirstName || usuario.nombre || '' %>
                    <%= usuario.LastName || usuario.apellido || '' %>
                </span>

                <span
                    class="user-badge"
                    style="text-transform: capitalize;"
                >
                    <%= rolActual %>
                </span>

            </a>

        <% } %>

        <!-- CERRAR SESIÓN -->
        <a
            href="/logout"
            id="btn-logout-action"
            class="btn-logout"
        >
            Cerrar Sesión
        </a>

    </div>

</nav>

<!-- LIMPIAR DATOS LOCALES AL CERRAR SESIÓN -->
<script>
    const btnLogout = document.getElementById('btn-logout-action');

    if (btnLogout) {
        btnLogout.addEventListener('click', function () {
            localStorage.removeItem('carrito');
            sessionStorage.clear();
        });
    }
</script>
