<nav class="navbar">

    <div class="navbar-brand">
        <span class="brand-title">
            AdventureWorks
        </span>
    </div>

    <% 
      // Obtener el rol actual en minúsculas
      const rolActual = (typeof usuario !== 'undefined' && usuario && (usuario.Rol || usuario.role)) 
        ? (usuario.Rol || usuario.role).toLowerCase() 
        : 'cliente'; 
    %>

    <ul class="navbar-links">
        <!-- Vistas visibles SOLO para CLIENTE -->
        <% if (rolActual === 'cliente') { %>
            <li>
                <a
                    href="/catalogo"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'catalogo' ? 'active' : '' %>"
                >
                    Catálogo
                </a>
            </li>
        <% } %>

        <!-- Vistas visibles SOLO para TRABAJADOR -->
        <% if (rolActual === 'trabajador') { %>
            <li>
                <a
                    href="/inventario"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'inventario' ? 'active' : '' %>"
                >
                    Inventario
                </a>
            </li>

            <li>
                <a 
                    href="/reportes"
                    class="<%= typeof pagina !== 'undefined' && pagina === 'reportes' ? 'active' : '' %>"
                >
                    Reportes
                </a>
            </li>
        <% } %>
    </ul>

    <div class="navbar-actions">

        <!-- Botón de Carrito SOLO visible para CLIENTE -->
        <% if (rolActual === 'cliente') { %>
            <a href="/carrito" class="btn-carrito">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path
                        d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
                    ></path>
                </svg>
                <span>Carrito</span>
            </a>
        <% } %>

        <!-- Datos del Usuario y Acceso a Perfil -->
        <% if (typeof usuario !== 'undefined' && usuario) { %>
            <a href="/perfil" class="user-profile-link" title="Abrir mi cuenta">
                <span class="user-name">
                    <%= usuario.FirstName || usuario.nombre || '' %> <%= usuario.LastName || usuario.apellido || '' %>
                </span>
                <span class="user-badge" style="text-transform: capitalize;">
                    <%= rolActual %>
                </span>
            </a>
        <% } %>

        <!-- Botón de Cerrar Sesión -->
        <a href="/logout" id="btn-logout-action" class="btn-logout">
            Cerrar Sesión
        </a>

    </div>

</nav>

<script>
    // Limpieza de datos locales al hacer logout para evitar contaminación de carritos
    document.getElementById('btn-logout-action')?.addEventListener('click', function() {
        localStorage.removeItem('carrito');
        sessionStorage.clear();
    });
</script>