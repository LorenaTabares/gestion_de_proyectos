
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventario - AdventureWorks</title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/inventario.css">
    <link rel="stylesheet" href="../css/footer.css">

    <script>
        (function bloquearAcceso() {
            const usuarioGuardado = JSON.parse(sessionStorage.getItem('usuario'));

            if (!usuarioGuardado || usuarioGuardado.role !== 'trabajador') {
                alert('Acceso denegado: Esta sección es exclusiva para personal de bodega.');
                window.location.assign('/catalogo');
            }
        })();
    </script>
</head>
<body>
    <%- include('../../components/navbar.ejs') %>

    <main>
        <div class="inventario-titulo">
            <h1>Inventario de Pedidos</h1>
            <p>Consulta los pedidos, las ubicaciones físicas de los productos y actualiza su estado.</p>
        </div>

        <div class="tablero">
            <!-- PEDIDOS PENDIENTES -->
            <section class="columna columna-pendiente">
                <h2>Pendiente (<%= pedidosPorEstado.pendiente.length %>)</h2>

                <% if (pedidosPorEstado.pendiente.length === 0) { %>
                    <div class="sin-pedidos">No hay pedidos pendientes.</div>
                <% } %>

                <% pedidosPorEstado.pendiente.forEach(pedido => { %>
                    <div class="pedido-card">
                        <div class="pedido-header">
                            <span class="pedido-id">Pedido #<%= pedido.SalesOrderID %></span>
                            <span class="pedido-fecha"><%= pedido.OrderDate %></span>
                        </div>

                        <details class="productos-desplegable">
                            <summary>Ver productos (<%= pedido.productos.length %>)</summary>
                            <div class="lista-productos">
                                <% pedido.productos.forEach(producto => { %>
                                    <div class="producto">
                                        <div class="producto-nombre"><%= producto.Name %></div>
                                        <div class="producto-info">
                                            Código: <%= producto.ProductNumber %>
                                            &nbsp; | &nbsp;
                                            Cantidad pedida: <%= producto.OrderQty %>
                                        </div>

                                        <div class="producto-stock <%= producto.Stock <= 5 ? 'stock-rojo' : producto.Stock <= 20 ? 'stock-amarillo' : producto.Stock <= 50 ? 'stock-verde' : '' %>">
                                            Stock restante: <strong><%= producto.Stock %></strong> unidades
                                        </div>

                                        <div class="producto-ubicacion">
                                            <h4>Ubicación física del producto</h4>

                                            <% if (producto.ubicaciones && producto.ubicaciones.length > 0) { %>
                                                <% producto.ubicaciones.forEach(ubicacion => { %>
                                                    <div class="ubicacion-detalle">
                                                        <p><strong>Zona:</strong> <%= ubicacion.Zona %></p>
                                                        <p><strong>Pasillo:</strong> <%= ubicacion.Pasillo %></p>
                                                        <p><strong>Estante:</strong> <%= ubicacion.Estante %></p>
                                                        <p><strong>Bin / Plataforma:</strong> <%= ubicacion.Bin %></p>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <p>Este producto no tiene una ubicación asignada.</p>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        </details>

                        <div class="pedido-estado">
                            <label>Estado del pedido:</label>
                            <form action="/inventario/estado" method="POST">
                                <input type="hidden" name="SalesOrderID" value="<%= pedido.SalesOrderID %>">
                                <select name="Status" class="estado-pedido" onchange="this.form.submit()">
                                    <option value="1" selected>Pendiente</option>
                                    <option value="2">En proceso</option>
                                    <option value="3">Despachado</option>
                                    <option value="4">Cancelado</option>
                                </select>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </section>

