<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Inventario - AdventureWorks</title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/inventario.css">
    <link rel="stylesheet" href="../css/footer.css">

</head>


<body>


    <!-- NAVBAR -->
    <%- include('../../components/navbar.ejs') %>


    <!-- =====================================
         CONTENIDO
    ====================================== -->

    <main>


        <div class="inventario-titulo">

            <h1>Inventario de Pedidos</h1>

            <p>
                Consulta los pedidos y actualiza
                su estado.
            </p>

        </div>



        <div class="tablero">


            <!-- =================================
                 PENDIENTES
            ================================== -->

            <section
                class="columna columna-pendiente"
            >

                <h2>
                    Pendiente
                    (<%= pedidosPorEstado.pendiente.length %>)
                </h2>


                <% if (pedidosPorEstado.pendiente.length === 0) { %>

                    <div class="sin-pedidos">
                        No hay pedidos pendientes.
                    </div>

                <% } %>


                <% pedidosPorEstado.pendiente.forEach(pedido => { %>


                    <div class="pedido-card">


                        <div class="pedido-header">

                            <span class="pedido-id">
                                Pedido #<%= pedido.SalesOrderID %>
                            </span>

                            <span class="pedido-fecha">
                                <%= pedido.OrderDate %>
                            </span>

                        </div>



                        <!-- PRODUCTOS DESPLEGABLE -->

                        <details
                            class="productos-desplegable"
                        >

                            <summary>
                                Ver productos
                                (<%= pedido.productos.length %>)
                            </summary>


                            <div class="lista-productos">


                                <% pedido.productos.forEach(producto => { %>

                                    <div class="producto">

                                        <div class="producto-nombre">
                                            <%= producto.Name %>
                                        </div>

                                        <div class="producto-info">

                                            Código:
                                            <%= producto.ProductNumber %>

                                            &nbsp; | &nbsp;

                                            Cantidad:
                                            <%= producto.OrderQty %>

                                        </div>

                                    </div>

                                <% }); %>


                            </div>

                        </details>



                        <!-- ESTADO SIEMPRE VISIBLE -->

                        <div class="pedido-estado">

                            <label>
                                Estado del pedido:
                            </label>


                            <form
                                action="/inventario/estado"
                                method="POST"
                            >

                                <input
                                    type="hidden"
                                    name="SalesOrderID"
                                    value="<%= pedido.SalesOrderID %>"
                                >


                                <select
                                    name="Status"
                                    class="estado-pedido"
                                    onchange="this.form.submit()"
                                >

                                    <option
                                        value="1"
                                        selected
                                    >
                                        Pendiente
                                    </option>

                                    <option value="2">
                                        En proceso
                                    </option>

                                    <option value="3">
                                        Despachado
                                    </option>

                                    <option value="4">
                                        Cancelado
                                    </option>

                                </select>

                            </form>

                        </div>


                    </div>


                <% }); %>


            </section>



