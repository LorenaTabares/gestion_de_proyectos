                <h2>Cancelado (<%= pedidosPorEstado.cancelado.length %>)</h2>

                <% if (pedidosPorEstado.cancelado.length === 0) { %>
                    <div class="sin-pedidos">No hay pedidos cancelados.</div>
                <% } %>

                <% pedidosPorEstado.cancelado.forEach(pedido => { %>
                    <div class="pedido-card">
                        <div class="pedido-header">
                            <span class="pedido-id">Pedido #<%= pedido.SalesOrderID %></span>
