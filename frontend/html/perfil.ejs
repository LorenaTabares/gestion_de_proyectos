<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi cuenta - AdventureWorks</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/perfil.css">
</head>
<body>
    <%- include('../../components/navbar.ejs') %>
    <main class="perfil-container">
        <header class="perfil-header">
            <p class="perfil-kicker">CUENTA PERSONAL</p>
            <h1>Mi cuenta</h1>
            <p>Administra tu información personal, de contacto y seguridad.</p>
        </header>

        <section class="perfil-grid">
            <article class="perfil-panel perfil-foto-panel">
                <div class="perfil-avatar-wrap">
                    <% if (fotoPerfil) { %>
                        <img id="avatar-preview" src="<%= fotoPerfil %>" alt="Foto de perfil">
                    <% } else { %>
                        <div id="avatar-preview" class="perfil-avatar-placeholder"><%= perfil.FirstName.charAt(0).toUpperCase() %></div>
                    <% } %>
                </div>
                <h2>Foto de perfil</h2>
                <p>JPG, PNG o GIF de máximo 500 KB.</p>
                <input id="profile-photo" type="file" accept="image/png,image/jpeg,image/gif" hidden>
                <button class="btn-secondary" type="button" id="select-photo">Elegir foto</button>
                <button class="btn-primary" type="button" id="save-photo">Guardar foto</button>
            </article>

            <article class="perfil-panel">
                <h2>Información personal y de contacto</h2>
                <form id="perfil-form" class="perfil-form">
                    <label>Nombre<input name="firstName" value="<%= perfil.FirstName || '' %>"></label>
                    <label>Apellido<input name="lastName" value="<%= perfil.LastName || '' %>"></label>
                    <label>Correo electrónico<input name="email" type="email" value="<%= perfil.EmailAddress || '' %>"></label>
                    <label>Teléfono<input name="phone" value="<%= perfil.Phone || '' %>"></label>
                    <label>Dirección<input name="addressLine1" value="<%= perfil.AddressLine1 || '' %>"></label>
                    <label>Detalles<input name="addressLine2" value="<%= perfil.AddressLine2 || '' %>" placeholder="Ejemplo: Apartamento 302, Torre B, barrio El Bosque"></label>
                    <div class="perfil-form-row">
                        <label>Ciudad<input name="city" value="<%= perfil.City || '' %>"></label>
                        <label>Estado / Departamento<input name="stateProvince" value="<%= perfil.StateProvince || '' %>"></label>
                    </div>
                    <div class="perfil-form-row">
                        <label>País<input name="countryRegion" value="<%= perfil.CountryRegion || '' %>"></label>
                        <label>Código postal<input name="postalCode" value="<%= perfil.PostalCode || '' %>"></label>
                    </div>
                    <button class="btn-primary" type="submit">Guardar cambios</button>
                </form>
            </article>

            <article class="perfil-panel perfil-password-panel">
                <h2>Cambiar contraseña</h2>
                <form id="password-form" class="perfil-form">
                    <label>Contraseña actual<input name="currentPassword" type="password" required></label>
                    <label>Nueva contraseña<input name="newPassword" type="password" minlength="8" required></label>
                    <label>Confirmar nueva contraseña<input name="confirmPassword" type="password" minlength="8" required></label>
                    <button class="btn-primary" type="submit">Cambiar contraseña</button>
                </form>
            </article>
        </section>
    </main>

    <div id="alert-modal" class="modal hidden" aria-live="polite" aria-modal="true" role="dialog">
        <div class="modal-content">
            <button type="button" class="modal-close" aria-label="Cerrar mensaje">×</button>
            <div id="alert-icon" class="alert-icon">!</div>
            <h3 id="alert-title">Mensaje</h3>
            <p id="alert-text">Texto del aviso.</p>
        </div>
    </div>

    <script>
        const modal = document.querySelector('#alert-modal');
        const modalTitle = document.querySelector('#alert-title');
        const modalText = document.querySelector('#alert-text');
        const modalIcon = document.querySelector('#alert-icon');

        const showMessage = (text, type = 'success') => {
            modalTitle.textContent = type === 'success' ? 'Confirmación' : 'Advertencia';
            modalText.textContent = text;
            modalIcon.textContent = type === 'success' ? '✓' : '!';
            modalIcon.classList.toggle('success', type === 'success');
            modalIcon.classList.toggle('error', type !== 'success');
            modal.classList.remove('hidden');
        };

        const closeMessage = () => {
            modal.classList.add('hidden');
        };

        document.querySelector('.modal-close').addEventListener('click', closeMessage);
        modal.addEventListener('click', (event) => {
            if (event.target === modal) closeMessage();
        });

        const send = async (url, data) => {
            const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            const result = await response.json();
            if (!response.ok) throw new Error(result.message || 'Hubo un problema.');
            showMessage(result.message || 'Operación realizada correctamente.', 'success');
            return result;
        };
        const formData = form => Object.fromEntries(new FormData(form));

        const perfilForm = document.querySelector('#perfil-form');
        const passwordForm = document.querySelector('#password-form');
        const input = document.querySelector('#profile-photo');

        perfilForm.addEventListener('submit', async event => {
            event.preventDefault();
            try {
                const data = formData(event.currentTarget);
                const email = (data.email || '').trim();
                const firstName = (data.firstName || '').trim();

                if (!firstName && !email && !data.lastName && !data.phone && !data.addressLine1 && !data.addressLine2 && !data.city && !data.stateProvince && !data.countryRegion && !data.postalCode) {
                    showMessage('No has escrito ningún dato para guardar.', 'error');
                    return;
                }

                if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    showMessage('El correo electrónico no tiene un formato válido.', 'error');
                    return;
                }

                await send('/api/perfil/datos', data);
            }
            catch (error) {
                showMessage(error.message, 'error');
            }
        });
        passwordForm.addEventListener('submit', async event => {
            event.preventDefault();
            try {
                await send('/api/perfil/password', formData(passwordForm));
                passwordForm.reset();
            }
            catch (error) { showMessage(error.message, 'error'); }
        });

        document.querySelector('#select-photo').addEventListener('click', () => input.click());
        input.addEventListener('change', () => {
            const file = input.files[0];
            if (!file) return;
            if (file.size > 500 * 1024) { showMessage('La foto debe ser menor de 500 KB.', 'error'); input.value = ''; return; }
            const reader = new FileReader();
            reader.onload = () => document.querySelector('#avatar-preview').outerHTML = `<img id="avatar-preview" src="${reader.result}" alt="Foto de perfil">`;
            reader.readAsDataURL(file);
        });
        document.querySelector('#save-photo').addEventListener('click', () => {
            const file = input.files[0];
            if (!file) { showMessage('Elige una foto antes de guardarla.', 'error'); return; }
            const reader = new FileReader();
            reader.onload = async () => {
                try { await send('/api/perfil/foto', { foto: reader.result }); }
                catch (error) { showMessage(error.message, 'error'); }
            };
            reader.readAsDataURL(file);
        });
    </script>
</body>
</html>
